# ==============================================================================
# Health Management System (HMS) Environment Configuration
# ==============================================================================
# Copy this file to .env for local development (never commit .env to Git).
# For production deployments (Render, Railway, Fly.io), set these in the
# hosting provider's dashboard environment variables instead of using .env.

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
# On Render/Railway/Heroku this is auto-injected; do not set it manually there.
PORT=3000

# Node.js runtime environment.
# REQUIRED: Set to "production" in all cloud hosting deployments.
# When set to "production":
#   - Session cookies are marked Secure (HTTPS only)
#   - Embedded PGlite is disabled; DATABASE_URL is required
#   - pino logs JSON (no pino-pretty colors)
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#
# REQUIRED in production (when NODE_ENV=production).
# Without DATABASE_URL in production the app exits immediately with a fatal
# error — embedded PGlite exceeds 512 MiB on Render free/starter instances.
#
# On Render: provision a PostgreSQL database in the dashboard and use the
# "Internal Database URL" as the value. With render.yaml the DATABASE_URL is
# injected automatically from the linked database — no manual copy needed.
#
# Examples:
#   Render internal:   postgresql://hms_user:pass@dpg-xxx.oregon-postgres.render.com/hms_db
#   Render external:   postgresql://hms_user:pass@dpg-xxx.virginia-postgres.render.com/hms_db?sslmode=require
#   Local Docker:      postgresql://postgres:postgres@localhost:5432/hms_db
#   Leave blank to use embedded PGlite (development only, persisted to ./data/hms_db):
# DATABASE_URL=postgresql://user:password@host:5432/hms_db

# ── Frontend ───────────────────────────────────────────────────────────────────
# Base path for static frontend asset serving (default: /).
# Only set this if the app is served from a subpath (e.g. /hms/).
BASE_PATH=/

# ==============================================================================
# Health Management System (HMS) Environment Configuration
# ==============================================================================

# Server Port (defaults to 3000 if not specified)
PORT=3000

# Environment: "development" or "production"
NODE_ENV=development

# Database Connection URL (Optional for local development)
# - Leave blank to use the built-in embedded PostgreSQL database (persisted to ./data/hms_db)
# - For production PostgreSQL (Render, Supabase, Neon, Railway, Docker, or local PG), provide:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hms_db

# Frontend Dev Base Path (defaults to /)
BASE_PATH=/
